# --- Telegram Bot ---
# Получите токен у @BotFather в Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCDEF_your_bot_token_here
# Ваш Telegram Chat ID (узнать можно у @userinfobot или после /start)
TELEGRAM_CHAT_ID=123456789
# Required only for Telegram webhook hosting on Vercel (set as Vercel secrets).
TELEGRAM_WEBHOOK_SECRET=
CRON_SECRET=

# --- Moodle LMS (Astana IT University) ---
# Базовый URL Moodle (без / в конце)
MOODLE_BASE_URL=https://lms.astanait.edu.kz
# Режим авторизации и парсинга:
#   auto   - пробует REST API и при 403/отключении автоматически переходит на Web HTML/AJAX
#   web    - вход через форму /login/index.php по логину и паролю Moodle
#   cookie - готовая cookie MoodleSession (если вы входите через OpenID Connect / Microsoft SSO)
MOODLE_AUTH_MODE=auto

# Вариант A: Логин и пароль Moodle (если используете обычный вход на /login/index.php)
MOODLE_USERNAME=
MOODLE_PASSWORD=

# Вариант B: Cookie MoodleSession (если входите через кнопку "Log in with OpenID Connect" / Microsoft)
# Скопируйте значение MoodleSession из DevTools -> Application -> Cookies -> lms.astanait.edu.kz
# Также можно обновлять на лету прямо в боте командой: /setcookie <значение>
MOODLE_SESSION_COOKIE=
# Required for user-submitted sessions. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MOODLE_COOKIE_ENCRYPTION_KEY=
# Отдельный локальный профиль Microsoft SSO для автоматического восстановления Moodle-сессии
MOODLE_SSO_PROFILE_DIR=data/moodle_sso_profile

# Вариант C: Готовый Web Service Token (на lms.astanait.edu.kz /webservice/rest/server.php закрыт 403)
MOODLE_TOKEN=
MOODLE_SERVICE=moodle_mobile_app

# --- Расписание проверок и напоминания ---
# Интервал опроса Moodle в секундах (по умолчанию 300 = 5 минут; на lms.astanait.edu.kz таймаут сессии 25 мин,
# поэтому опрос каждые 5 минут автоматически продлевает активную MoodleSession)
POLL_INTERVAL_SECONDS=300
# Таймзона для отображения дат
TIMEZONE=Asia/Almaty
# Пороги напоминаний о дедлайне в часах:
# 120 = 5 дней, 72 = 3 дня, 48 = 2 дня, 24 = 1 день, 12 = 12 часов, 3 = 3 часа
DEADLINE_REMINDER_HOURS=120,72,48,24,12,3
# Не присылать напоминания о дедлайнах, если работа уже сдана (submitted)
SKIP_SUBMITTED_DEADLINES=true
# Отправлять ли уведомления об уже существующих оценках/заданиях при самом первом запуске
NOTIFY_ON_FIRST_RUN=false
# Присылать ли уведомление об изменении даты дедлайна существующего задания
NOTIFY_ON_DEADLINE_CHANGE=true
# Сколько дней вперед показывать в команде /deadlines и проверять в календаре
LOOKAHEAD_DAYS=30
# Максимум последовательных ошибок синхронизации до отправки тревоги в Telegram
ERROR_ALERT_THRESHOLD=3

# --- База данных и логи ---
DATABASE_URL=sqlite+aiosqlite:///data/lms_notifier.db
LOG_LEVEL=INFO
REQUEST_TIMEOUT_SECONDS=25
SSL_VERIFY=true
